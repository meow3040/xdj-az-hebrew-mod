diff --git a/tests/unit/run.sh b/tests/unit/run.sh
index 1f62033..91f2081 100755
--- a/tests/unit/run.sh
+++ b/tests/unit/run.sh
@@ -71,6 +71,9 @@
 #   pdbthreads   two sticks synced at once (ThreadSanitizer): one sync at a time (pdb_sync.c)
 #   utf8cut      names copied into fixed buffers are cut at a character boundary (utf8_cut.h,
 #                library_db.c sq_text, ep_mem.h own_str)
+#   bidi         the Hebrew mod's line reordering: right-to-left titles, mixed lines, numbers,
+#                brackets (guest/azmod/bidi_logic.h); with BIDI_UCD=<BidiCharacterTest.txt> also
+#                every conformance line the subset covers
 #   lspdbsync    a name or path copy that fails stops the export.pdb sync: rc -1, nothing
 #                handed to pdbs_sync, every copy freed (library_edits.c ls_pdb_sync_root)
 #   pdb_stock    export.pdb after EP147's own playlist writes: one sync per burst, whether or not
@@ -1316,6 +1319,17 @@ for v in real ctl-bytewise; do
         -o "$d/$v" $T/utf8cut_test.c
 done
 suite "utf8 cut" "$d/real"
+# ---------------------------------------------------------------- Hebrew: line reordering
+d="$OUT/bidi"; mkdir -p "$d"
+cp guest/azmod/bidi_logic.h "$d/real.h"
+cp guest/azmod/bidi_tables.h "$d/"
+# controls: no mirroring at odd levels (L4); no bracket pairs (N0)
+mutate "$d/real.h" "$d/ctl-nomirror.h" 's/(static inline uint32_t bidi_mirror\(uint32_t cp\) \{\n)/$1    return cp;\n/'
+mutate "$d/real.h" "$d/ctl-non0.h" 's/(        for \(int p = 0; p < np; p\+\+\) \{\n)/        np = 0;\n$1/'
+for v in real ctl-nomirror ctl-non0; do
+    $CC "${CFLAGS[@]}" -I$T -DBIDI_INC="\"$d/$v.h\"" -o "$d/$v" $T/bidi_test.c
+done
+suite "bidi" "$d/real" ${BIDI_UCD:+"$BIDI_UCD"}
 # ---------------------------------------------------------------- export.pdb sync: library read
 d="$OUT/lspdbsync"; mkdir -p "$d"
 awk '/^struct pdbs_pl \{/ {p=1} p {print} p && /^\};/ && ++n == 3 {exit}' guest/azmod/pdb_sync.c > "$d/structs.inc"
@@ -2778,6 +2792,8 @@ if [ "$PT_TSAN" = 1 ]; then
 control "export.pdb sync: two sticks at once without the lock (TSan race)" env TSAN_OPTIONS=halt_on_error=1 "$OUT/pdbthreads/tsan-ctl-nolock" 10
 fi
 control "utf8 cut: names cut byte-wise"                           "$OUT/utf8cut/ctl-bytewise"
+control "bidi: no mirroring at odd levels (L4)"                   "$OUT/bidi/ctl-nomirror"
+control "bidi: no bracket pairs (N0)"                             "$OUT/bidi/ctl-non0"
 control "drumroll: format code ignored"                 "$OUT/drum/ctl-tag" "$OUT/drum/scratch"
 control "drumroll: any PCM bit depth accepted"           "$OUT/drum/ctl-depth" "$OUT/drum/scratch"
 if [ "$PUBLIC" = 1 ]; then   # caught by the steady-roll case, which reads the development-only hit record
diff --git a/tools/format-check.sh b/tools/format-check.sh
index a471f97..01dd9f8 100755
--- a/tools/format-check.sh
+++ b/tools/format-check.sh
@@ -36,11 +36,14 @@ EXCLUDE=(
     '^guest/azmod/ep147addr\.h$'        # per-firmware address table
     '^guest/azstem/ep147addr\.h$'       # per-firmware address table
     '^guest/azmod/ep147png\.h$'         # tools/ep147-pngtable.py
+    '^guest/azmod/bidi_tables\.h$'      # tools/hebrew-assets.py: the Unicode bidi tables
+    '^guest/azmod/heb_glyphs\.h$'       # tools/hebrew-assets.py: Hebrew outlines from DejaVu Sans Bold
     # GENERATED art: image bytes as C arrays, each header written by its own art tool
     '^guest/azmod/eyeicon\.h$'          # the Hide Title eye icon
     '^guest/azmod/fxart\.h$'            # Beat FX panel art
     '^guest/azmod/fxbars\.h$'           # Drum Roll Beat FX bar labels
     '^guest/azmod/fxhdr\.h$'            # the Drum Roll X-PAD header bar
+    '^guest/azmod/heb_keys\.h$'         # the Hebrew keyboard's key images (tools/hebrew-assets.py)
     '^guest/azmod/menu_icons\.h$'       # Mod Menu icons, from the SVGs in azmod/icons
     '^guest/azmod/menulabels\.h$'       # MENU panel labels
     '^guest/azmod/stems4art\.h$'        # 4-deck source-cell stem strips
